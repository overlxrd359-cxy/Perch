# ============================================================
# 复制为 .env 后按需修改：cp .env.example .env
# 生产环境务必替换 SECRET_KEY 与所有密码
# ============================================================

# 运行环境：dev | test | prod
APP_ENV=dev
DEBUG=true

# 必填：至少 32 位随机字符串
# 生成方式：openssl rand -hex 32
SECRET_KEY=dev-only-secret-key-change-me-0123456789abcdef

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=root_dev_pwd
MYSQL_DATABASE=campus_seat
MYSQL_USER=seat
MYSQL_PASSWORD=seat_dev_pwd
MYSQL_PORT=3306
DATABASE_URL=mysql+asyncmy://seat:seat_dev_pwd@127.0.0.1:3306/campus_seat?charset=utf8mb4

# ---- Redis ----
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0

# ---- Qdrant ----
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://127.0.0.1:6333

# ---- 前端 ----
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# ---- 跨域（逗号分隔） ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- 令牌 ----
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- LLM（M7 阶段再填） ----
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-m3